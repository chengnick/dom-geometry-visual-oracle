{
  "name": "ui-layout-oracle",
  "version": "1.0.0",
  "description": "跑在 CI 裡的單站視覺回歸 oracle：比對 DOM geometry baseline，判斷每個 PR 版面有沒有壞。不靠 pixel-diff、不存截圖。",
  "main": "index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test:visual": "playwright test tests/visual.spec.js",
    "test:unit": "playwright test tests/diff.spec.js --project=chromium",
    "layout:update": "node ui_layout_checker/capture.js --update-baseline",
    "layout:compare": "node ui_layout_checker/compare.js",
    "layout:report": "node ui_layout_checker/report-html.js --open",
    "test:smoke": "playwright test tests/smoke.spec.js"
  },
  "keywords": [],
  "author": "Nick Cheng",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1"
  }
}
